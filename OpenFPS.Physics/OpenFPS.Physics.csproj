<Project Sdk="Microsoft.NET.Sdk">

  <!-- The physics both games share (docs/PHYSICS_BOUNDARY.md, stage 1): the body on foot, a vehicle's
       running gear, wheels and tyres, the gearbox, a bullet's flight, the wind, and the laws of contact
       between them and the world. It uses the geometry and the materials and nothing else of ours: no sound,
       no acoustics, no entities. The server steps it, the client predicts the player's own body with it, and the sound
       reads its state.

       OpenFPS.Schema is the editor's attribute alone, which its presets carry (decision 7).

       Namespace OpenFPS.Physics, the project's (docs/SOUND_LIBRARY_BOUNDARY.md 21). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jolt Physics, solved behind OpenFPS.Physics' own body types (docs/PHYSICS_BOUNDARY.md 14.8, 18.2): nothing outside
         this project names it. MIT, as is Jolt. 2.22.0 of 2026-07-13, the one trialled; this is the one line to change.
         Its native package (JoltPhysics.Native) carries libjoltc.so and joltc.dll in runtimes/, which the build copies
         beside every executable that reaches this project. -->
    <PackageReference Include="JoltPhysicsSharp" Version="2.22.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Geometry\OpenFPS.Geometry.csproj" />
    <ProjectReference Include="..\OpenFPS.Materials\OpenFPS.Materials.csproj" />
    <ProjectReference Include="..\OpenFPS.Schema\OpenFPS.Schema.csproj" />
  </ItemGroup>

</Project>
