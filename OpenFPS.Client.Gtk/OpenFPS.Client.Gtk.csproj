<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenFPS.Client.Gtk</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
    <ProjectReference Include="..\OpenFPS.Client.Core\OpenFPS.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GTK4 .NET bindings (P/Invoke to the system libgtk-4). -->
    <PackageReference Include="GirCore.Gtk-4.0" Version="0.6.3" />
  </ItemGroup>

</Project>
