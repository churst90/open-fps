<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Speech\voices.csv" LogicalName="OpenFPS.Common.Speech.voices.csv" />
    <EmbeddedResource Include="Speech\scripts.json" LogicalName="OpenFPS.Common.Speech.scripts.json" />
  </ItemGroup>

  <!-- ── THE WIRE CONTRACT ────────────────────────────────────────────────────────────────────────
       Messages and components serialise positionally, so a client and a server built from different
       versions of this project do not fail: they misread each other. This hashes every source file
       of this project (sorted by path, line endings normalised, so a Windows checkout hashes the
       same) into WireContract.Hash. The client sends it with its login and the server refuses a
       mismatch by name, instead of a friend's out-of-date build spawning into garbage. -->
  <UsingTask TaskName="HashWireContract" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Root ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var root = Path.GetFullPath(Root).TrimEnd('/', '\\') + Path.DirectorySeparatorChar;
        var paths = Files.Select(f => Path.GetFullPath(f.ItemSpec))
                         // Only this project's own sources. The SDK also compiles generated files
                         // (global usings, assembly info) from the output folder, which is somewhere
                         // else for every build and would make two builds of the same code disagree.
                         .Where(p => p.StartsWith(root))
                         .Select(p => new { Full = p, Rel = p.Substring(root.Length).Replace('\\', '/') })
                         .Where(p => !p.Rel.StartsWith("obj/") && !p.Rel.StartsWith("bin/"))
                         .OrderBy(p => p.Rel, System.StringComparer.Ordinal);
        using (var sha = SHA256.Create())
        {
            var all = new StringBuilder();
            foreach (var p in paths)
                all.Append(p.Rel).Append('\n').Append(File.ReadAllText(p.Full).Replace("\r\n", "\n")).Append('\n');
            byte[] h = sha.ComputeHash(Encoding.UTF8.GetBytes(all.ToString()));
            Hash = string.Concat(h.Take(6).Select(b => b.ToString("x2")));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The project file is an input too: a change to how the hash is made must remake it, or a build
       folder keeps the old answer while a fresh one gets the new, and the two refuse each other. -->
  <Target Name="GenerateWireContract" BeforeTargets="CoreCompile" Inputs="@(Compile);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)WireContract.g.cs">
    <HashWireContract Files="@(Compile)" Root="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Hash" PropertyName="WireContractHash" />
    </HashWireContract>
    <WriteLinesToFile File="$(IntermediateOutputPath)WireContract.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace OpenFPS.Common%3B;/// &lt;summary&gt;A hash of this project's sources: client and server must match it to talk.&lt;/summary&gt;;public static class WireContract { public const string Hash = &quot;$(WireContractHash)&quot;%3B }" />
  </Target>
  <Target Name="IncludeWireContract" BeforeTargets="CoreCompile" AfterTargets="GenerateWireContract">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WireContract.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WireContract.g.cs" />
    </ItemGroup>
  </Target>

  <!-- ── THE DOOR MODELS' FINGERPRINT ─────────────────────────────────────────────────────────────
       The client keeps every door model render on disk (DoorRenderCache), and a render only changes
       when a door model does. Named by WireContract.Hash, the whole cache was thrown away by every
       change anywhere in this project, and the next launch rendered all of it again (Cody, 2026-10-06:
       "generate them once and keep them"). This hashes only the sources a door render is made from:
       the models and what they call. A new model file, or one that starts using another file, belongs
       in this list; DoorRenderCache.Version is the manual lever for anything else. -->
  <ItemGroup>
    <DoorModelSource Include="KnobDoor.cs;PushBarDoor.cs;SlidingDoor.cs;GlassDoor.cs;LockCylinder.cs;ElevatorDoor.cs;CarWindow.cs;GlassFracture.cs;DoorPhysics.cs;Doors.cs;Glass.cs;AcousticRegistry.cs;VehicleCabin.cs;VehicleBody.cs" />
  </ItemGroup>
  <Target Name="GenerateDoorModelFingerprint" BeforeTargets="CoreCompile" Inputs="@(DoorModelSource);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)DoorModelFingerprint.g.cs">
    <HashWireContract Files="@(DoorModelSource)" Root="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Hash" PropertyName="DoorModelHash" />
    </HashWireContract>
    <WriteLinesToFile File="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace OpenFPS.Common%3B;/// &lt;summary&gt;A hash of the sources a door model render is made from (OpenFPS.Common.csproj, DoorModelSource).&lt;/summary&gt;;public static class DoorModelFingerprint { public const string Hash = &quot;$(DoorModelHash)&quot;%3B }" />
  </Target>
  <Target Name="IncludeDoorModelFingerprint" BeforeTargets="CoreCompile" AfterTargets="GenerateDoorModelFingerprint">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" />
    </ItemGroup>
  </Target>

</Project>
