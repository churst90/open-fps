<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The geometry library (docs/SOUND_LIBRARY_BOUNDARY.md, stage 2). -->
    <ProjectReference Include="..\OpenFPS.Geometry\OpenFPS.Geometry.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- AudioClock.UseForTest: the emitter-stream replay runs every reader of the audio clock on its own. -->
    <InternalsVisibleTo Include="OpenFPS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Speech\voices.csv" LogicalName="OpenFPS.Common.Speech.voices.csv" />
    <EmbeddedResource Include="Speech\scripts.json" LogicalName="OpenFPS.Common.Speech.scripts.json" />
  </ItemGroup>

  <!-- ── THE WIRE CONTRACT ────────────────────────────────────────────────────────────────────────
       Messages and components serialise positionally, so builds from different versions do not fail,
       they misread each other. This hashes every source file of this project and its library projects
       (sorted by path from the repository's root, line endings normalised so a Windows checkout hashes
       the same) into WireContract.Hash; the server refuses a login whose hash differs.

       The library is in it because its types are on the wire (a collider's ShapeSpec, TileKey) and the
       client predicts movement with the server's geometry (docs/SOUND_LIBRARY_BOUNDARY.md, 15.3). -->
  <ItemGroup>
    <WireLibrarySource Include="..\OpenFPS.Geometry\**\*.cs" />
  </ItemGroup>
  <UsingTask TaskName="HashWireContract" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Root ParameterType="System.String" Required="true" />
      <Hash ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Security.Cryptography" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var root = Path.GetFullPath(Root).TrimEnd('/', '\\') + Path.DirectorySeparatorChar;
        var paths = Files.Select(f => Path.GetFullPath(f.ItemSpec))
                         // Only sources under the root: the SDK's generated files live in each build's
                         // output folder and would make two builds of the same code disagree.
                         .Where(p => p.StartsWith(root))
                         .Select(p => new { Full = p, Rel = p.Substring(root.Length).Replace('\\', '/') })
                         .Where(p => !p.Rel.Split('/').Any(s => s == "obj" || s == "bin"))
                         .OrderBy(p => p.Rel, System.StringComparer.Ordinal);
        using (var sha = SHA256.Create())
        {
            var all = new StringBuilder();
            foreach (var p in paths)
                all.Append(p.Rel).Append('\n').Append(File.ReadAllText(p.Full).Replace("\r\n", "\n")).Append('\n');
            byte[] h = sha.ComputeHash(Encoding.UTF8.GetBytes(all.ToString()));
            Hash = string.Concat(h.Take(6).Select(b => b.ToString("x2")));
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The project file is an input too: otherwise a change to how the hash is made leaves an old build
       folder with the old answer, and it refuses a fresh one. -->
  <Target Name="GenerateWireContract" BeforeTargets="CoreCompile" Inputs="@(Compile);@(WireLibrarySource);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)WireContract.g.cs">
    <HashWireContract Files="@(Compile);@(WireLibrarySource)" Root="$(MSBuildProjectDirectory)\..">
      <Output TaskParameter="Hash" PropertyName="WireContractHash" />
    </HashWireContract>
    <WriteLinesToFile File="$(IntermediateOutputPath)WireContract.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace OpenFPS.Common%3B;/// &lt;summary&gt;A hash of this project's sources and its library's: client and server must match it to talk.&lt;/summary&gt;;public static class WireContract { public const string Hash = &quot;$(WireContractHash)&quot;%3B }" />
  </Target>
  <Target Name="IncludeWireContract" BeforeTargets="CoreCompile" AfterTargets="GenerateWireContract">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WireContract.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WireContract.g.cs" />
    </ItemGroup>
  </Target>

  <!-- ── THE DOOR MODELS' FINGERPRINT ─────────────────────────────────────────────────────────────
       Names the client's door render cache (DoorRenderCache). Named by WireContract.Hash, every change
       to this project rendered it all again (Cody, 2026-10-06: "generate them once and keep them"), so
       this hashes only the sources a door render is made from. A new model file, or one a model starts
       using, belongs in this list; DoorRenderCache.Version is the manual lever for anything else. -->
  <ItemGroup>
    <DoorModelSource Include="KnobDoor.cs;PushBarDoor.cs;SlidingDoor.cs;GlassDoor.cs;LockCylinder.cs;ElevatorDoor.cs;CarWindow.cs;GlassFracture.cs;DoorPhysics.cs;Doors.cs;Glass.cs;AcousticRegistry.cs;VehicleCabin.cs;VehicleBody.cs" />
  </ItemGroup>
  <Target Name="GenerateDoorModelFingerprint" BeforeTargets="CoreCompile" Inputs="@(DoorModelSource);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)DoorModelFingerprint.g.cs">
    <HashWireContract Files="@(DoorModelSource)" Root="$(MSBuildProjectDirectory)">
      <Output TaskParameter="Hash" PropertyName="DoorModelHash" />
    </HashWireContract>
    <WriteLinesToFile File="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace OpenFPS.Common%3B;/// &lt;summary&gt;A hash of the sources a door model render is made from (OpenFPS.Common.csproj, DoorModelSource).&lt;/summary&gt;;public static class DoorModelFingerprint { public const string Hash = &quot;$(DoorModelHash)&quot;%3B }" />
  </Target>
  <Target Name="IncludeDoorModelFingerprint" BeforeTargets="CoreCompile" AfterTargets="GenerateDoorModelFingerprint">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)DoorModelFingerprint.g.cs" />
    </ItemGroup>
  </Target>

</Project>
