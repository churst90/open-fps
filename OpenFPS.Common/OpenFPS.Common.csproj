<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sound library's lower projects (docs/SOUND_LIBRARY_BOUNDARY.md, section 6): the geometry
         (stage 2), the acoustics and the sound models (stage 3). Never OpenFPS.Native: the server
         references this project and must not load FMOD. -->
    <ProjectReference Include="..\OpenFPS.Geometry\OpenFPS.Geometry.csproj" />
    <ProjectReference Include="..\OpenFPS.Acoustics\OpenFPS.Acoustics.csproj" />
    <ProjectReference Include="..\OpenFPS.Sound\OpenFPS.Sound.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Arch" Version="2.1.0" />
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="MemoryPack" Version="1.21.4" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the opening routes' internals (their cache, MaxChainedBoxes). AudioClock.UseForTest,
         which this was for, moved to OpenFPS.Sound with the clock (stage 3). -->
    <InternalsVisibleTo Include="OpenFPS.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Speech\voices.csv" LogicalName="OpenFPS.Common.Speech.voices.csv" />
    <EmbeddedResource Include="Speech\scripts.json" LogicalName="OpenFPS.Common.Speech.scripts.json" />
  </ItemGroup>

  <!-- ── THE WIRE CONTRACT ────────────────────────────────────────────────────────────────────────
       Messages and components serialise positionally, so builds from different versions do not fail,
       they misread each other. This hashes every source file of this project and of the library projects
       below (sorted by path from the repository's root, line endings normalised so a Windows checkout
       hashes the same: tools/build/SourceHash.targets) into WireContract.Hash; the server refuses a login
       whose hash differs.

       The library is in it because its types are on the wire and the server and the client run the same
       models: a collider's ShapeSpec and TileKey (Geometry), and the client predicts movement with the
       server's geometry (docs/SOUND_LIBRARY_BOUNDARY.md, 15.3); TransientSound, WheelState, PlaybackMode,
       WeatherType, Precipitation, WindAir, LightningStrike, RoadWater and the rest of what the server
       sends of the weather and the vehicles (Sound), and the materials and walls both sides hear through
       (Acoustics). All of Acoustics and Sound came from this project in stage 3 and were in the hash
       already. Not Sound's Core/: the synthesis came from OpenFPS.Client.Core, only the client runs it,
       and it was never in the hash. -->
  <ItemGroup>
    <WireLibrarySource Include="..\OpenFPS.Geometry\**\*.cs" />
    <WireLibrarySource Include="..\OpenFPS.Acoustics\**\*.cs" />
    <WireLibrarySource Include="..\OpenFPS.Sound\**\*.cs" Exclude="..\OpenFPS.Sound\Core\**" />
  </ItemGroup>
  <Import Project="..\tools\build\SourceHash.targets" />

  <!-- The project file is an input too: otherwise a change to how the hash is made leaves an old build
       folder with the old answer, and it refuses a fresh one. -->
  <Target Name="GenerateWireContract" BeforeTargets="CoreCompile" Inputs="@(Compile);@(WireLibrarySource);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)WireContract.g.cs">
    <HashSources Files="@(Compile);@(WireLibrarySource)" Root="$(MSBuildProjectDirectory)\..">
      <Output TaskParameter="Hash" PropertyName="WireContractHash" />
    </HashSources>
    <WriteLinesToFile File="$(IntermediateOutputPath)WireContract.g.cs" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace OpenFPS.Common%3B;/// &lt;summary&gt;A hash of this project's sources and its library's: client and server must match it to talk.&lt;/summary&gt;;public static class WireContract { public const string Hash = &quot;$(WireContractHash)&quot;%3B }" />
  </Target>
  <Target Name="IncludeWireContract" BeforeTargets="CoreCompile" AfterTargets="GenerateWireContract">
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)WireContract.g.cs" />
      <FileWrites Include="$(IntermediateOutputPath)WireContract.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The door models' fingerprint (DoorModelFingerprint) moved with the door models to OpenFPS.Sound. -->

</Project>
