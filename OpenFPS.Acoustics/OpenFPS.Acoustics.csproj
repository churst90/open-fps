<Project Sdk="Microsoft.NET.Sdk">

  <!-- The sound library's acoustics (docs/SOUND_LIBRARY_BOUNDARY.md, stages 3 and 4): the materials and what
       a wall, a panel and a layered construction let through, diffraction over an edge, reflections and
       image sources, how enclosed a place is, the voxel octree, the constants they share, and the rooms and
       openings (Room, Opening, AcousticMap, RoomAcoustics, OpeningRoutes, FaceOpenings,
       AcousticVolumeGenerator), which the host fills from its own entities. It uses only the geometry and the
       materials (OpenFPS.Materials, where the material table went: docs/ENGINE_PACKAGES.md, stage 1).

       Namespaces are those the files had in OpenFPS.Common (decision 6). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Geometry\OpenFPS.Geometry.csproj" />
    <ProjectReference Include="..\OpenFPS.Materials\OpenFPS.Materials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the walls' internals (WallTransmission.Faces) and the opening routes' (their cache,
         MaxChainedBoxes). -->
    <InternalsVisibleTo Include="OpenFPS.Tests" />
  </ItemGroup>

</Project>
