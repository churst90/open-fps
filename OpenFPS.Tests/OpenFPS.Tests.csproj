<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- LibraryBoundaryTests reads the library's sources as syntax (no binding) to count host names. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
    <ProjectReference Include="..\OpenFPS.Client.Core\OpenFPS.Client.Core.csproj" />
    <!-- The map/prefab loaders live in the server. Referenced so the portal pipeline can be tested
         against the real shipped data rather than a hand-built stand-in. -->
    <ProjectReference Include="..\OpenFPS.Server\OpenFPS.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Real shipped map + prefab data, copied so tests run against exactly what the server loads. -->
    <None Include="..\OpenFPS.Server\maps\*.json" Link="maps\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\OpenFPS.Server\prefabs\*.json" Link="prefabs\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The maps of real places, in a folder of their own: under maps\ they would be loaded by every
         test that loads the shipped maps. RealPlaceMapTests loads each one alone. -->
    <None Include="..\OpenFPS.Server\maps\places\*.json" Link="places\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Their ground, a file beside each (MapElevation.File). -->
    <None Include="..\OpenFPS.Server\maps\places\*.elevation" Link="places\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The rooms map (doors, portals, the material lab): a fixture only, never served to players. -->
    <None Update="maps\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- At most four test classes at once (2026-10-07). Many start audio, acoustics and Steam Audio threads of
         their own: at the default, one per core, a run on the 24-core desk machine reached a load of 350 and locked
         the desktop and the screen reader. GitHub's runners have four cores, so CI is unchanged. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Linux head's key map, which is plain code over GameKey: compiled in here so the keys it
         reports (Shift-comma as comma, not "<") are tested without referencing GTK. -->
    <Compile Include="..\OpenFPS.Client.Gtk\Game\GtkKeyMap.cs" Link="Linked\GtkKeyMap.cs" />
    <!-- And the Windows head's test for the keypad with Num Lock off, which is plain virtual key codes. -->
    <Compile Include="..\OpenFPS.Client\Core\KeypadKeys.cs" Link="Linked\KeypadKeys.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>