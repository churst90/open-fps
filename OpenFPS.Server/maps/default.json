{
  "Id": "default",
  "Size": { "X": 100, "Y": 40, "Z": 100 },
  "MinBound": { "X": -50, "Y": 0, "Z": -50 },
  "MaxBound": { "X": 50, "Y": 40, "Z": 50 },
  "SpawnPoint": { "Position": { "X": 0, "Y": 1, "Z": 0 }, "Rotation": { "X": 0, "Y": 0, "Z": 0, "W": 1 } },
  // Outdoor soundfield for the whole map: a first-order ambisonic recording, so it stays put in the
  // world while the player turns in it. The client ducks it by shelter rather than switching it off,
  // so stepping into a room takes the outside down instead of away.
  "AmbienceId": "AMBIENCE/woods_mid_day",
  // A big-block muscle car drives the road in front of the spawn point, four and a half metres out,
  // east to west and back, at 30, 60 and 90 km/h in turn. The client synthesizes its engine live.
  "Vehicles": [
    {
      "Name": "big-block muscle car",
      "Preset": "v8_muscle",
      "RoadStart": { "X": -46, "Y": 0.6, "Z": 4.5 },
      "RoadEnd": { "X": 46, "Y": 0.6, "Z": 4.5 },
      "SpeedsKmh": [ 30, 60, 90 ],
      "WaitSeconds": 5,
      "StartDelaySeconds": 8
    }
  ],
  "VoxelResolution": 0.5,
  "OcclusionFloor": 0.15,
  "Entities": [
    // ============================================================
    //  OCCLUSION / MATERIAL DEMO
    //  Spawn at (0,1,0) facing NORTH (+Z). Two rooms ahead at z=15.
    //  Doors face south (toward you) at z=10: concrete room door x=-7, wood room door x=+7.
    // ============================================================

    // --- GROUND: big concrete slab under the whole play area (x[-20,20], z[-10,30]) ---
    { "EntityId": 100, "PrefabId": "concrete_floor", "Position": { "X": 0, "Y": 0, "Z": 10 }, "Scale": { "X": 4, "Y": 1, "Z": 4 } },

    // --- MATERIAL ZONES (sit just above the slab; change footstep sound when walked on) ---
    // Grass approach strip between spawn and the doors (z 4.5..9.5).
    { "EntityId": 110, "PrefabId": "grass_floor", "Position": { "X": 0, "Y": 0.05, "Z": 7 }, "Scale": { "X": 1.5, "Y": 1, "Z": 0.5 } },
    // Dirt area off to the west.
    { "EntityId": 111, "PrefabId": "dirt_floor", "Position": { "X": -15, "Y": 0.05, "Z": 5 }, "Scale": { "X": 1, "Y": 1, "Z": 1 } },

    // ============================================================
    //  ROOM A — CONCRETE, with an OMNIDIRECTIONAL SIREN inside.
    //  Interior x[-12,-2], z[10,20]. Door (gap) centered x=-7 at z=10.
    // ============================================================
    { "EntityId": 200, "PrefabId": "concrete_wall", "Position": { "X": -7,  "Y": 2, "Z": 20 }, "Scale": { "X": 5,    "Y": 1.333, "Z": 1 } }, // north
    { "EntityId": 201, "PrefabId": "concrete_wall", "Position": { "X": -2,  "Y": 2, "Z": 15 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // east
    { "EntityId": 202, "PrefabId": "concrete_wall", "Position": { "X": -12, "Y": 2, "Z": 15 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // west
    { "EntityId": 203, "PrefabId": "concrete_wall", "Position": { "X": -10, "Y": 2, "Z": 10 }, "Scale": { "X": 2,    "Y": 1.333, "Z": 1 } }, // south-left  (x -12..-8)
    { "EntityId": 204, "PrefabId": "concrete_wall", "Position": { "X": -4,  "Y": 2, "Z": 10 }, "Scale": { "X": 2,    "Y": 1.333, "Z": 1 } }, // south-right (x -6..-2)  -> doorway x -8..-6
    { "EntityId": 205, "PrefabId": "concrete_floor", "Position": { "X": -7, "Y": 0.05, "Z": 15 }, "Scale": { "X": 1, "Y": 1, "Z": 1 } },
    { "EntityId": 210, "PrefabId": "acoustic_region", "Position": { "X": -7, "Y": 2, "Z": 15 }, "IsIndoor": true, "RoomMaterials": ["Concrete", "Concrete", "Concrete", "Concrete", "Concrete", "Concrete"] },
    { "EntityId": 211, "PrefabId": "portal", "Position": { "X": -7, "Y": 1, "Z": 10 }, "RegionAId": -1, "RegionBId": 210, "ApertureSize": 2.0 },
    // (the siren that used to stand here is gone — the room is quiet now, so the reverb and the
    //  boundary reflections are what you hear in it)

    // ============================================================
    //  ROOM B — WOOD floor, with the DIRECTIONAL MEGAPHONE inside,
    //  pointing SOUTH out the door (loud as you approach, quiet from behind).
    //  Interior x[2,12], z[10,20]. Door (gap) centered x=+7 at z=10.
    // ============================================================
    { "EntityId": 300, "PrefabId": "concrete_wall", "Position": { "X": 7,  "Y": 2, "Z": 20 }, "Scale": { "X": 5,    "Y": 1.333, "Z": 1 } }, // north
    { "EntityId": 301, "PrefabId": "concrete_wall", "Position": { "X": 12, "Y": 2, "Z": 15 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // east
    { "EntityId": 302, "PrefabId": "concrete_wall", "Position": { "X": 2,  "Y": 2, "Z": 15 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // west
    { "EntityId": 303, "PrefabId": "concrete_wall", "Position": { "X": 4,  "Y": 2, "Z": 10 }, "Scale": { "X": 2,    "Y": 1.333, "Z": 1 } }, // south-left  (x 2..6)
    { "EntityId": 304, "PrefabId": "concrete_wall", "Position": { "X": 10, "Y": 2, "Z": 10 }, "Scale": { "X": 2,    "Y": 1.333, "Z": 1 } }, // south-right (x 8..12) -> doorway x 6..8
    { "EntityId": 305, "PrefabId": "wood_floor", "Position": { "X": 7, "Y": 0.05, "Z": 15 }, "Scale": { "X": 1, "Y": 1, "Z": 1 } },
    { "EntityId": 310, "PrefabId": "acoustic_region", "Position": { "X": 7, "Y": 2, "Z": 15 }, "IsIndoor": true, "RoomMaterials": ["Wood", "Wood", "Wood", "Wood", "Wood", "Wood"] },
    { "EntityId": 311, "PrefabId": "portal", "Position": { "X": 7, "Y": 1, "Z": 10 }, "RegionAId": -1, "RegionBId": 310, "ApertureSize": 2.0 },
    { "EntityId": 320, "PrefabId": "space_megaphone", "Position": { "X": 7, "Y": 1.5, "Z": 15 }, "Rotation": { "X": 0, "Y": 1, "Z": 0, "W": 0 } },


    // ============================================================
    //  MATERIAL LAB — one open room, two acoustic halves (interior z[30,40]).
    //  WEST half (x[-10,0]) = CARPET / FOAM: sound-deadening, little/no reverb.
    //  EAST half (x[0,10])  = GYM: concrete walls + wood floor, live & reverberant.
    //  The megaphone sits on the DEAD (west) side, beaming EAST into the live half — so from
    //  the gym you hear it come from the quiet side and reverberate around you; on the carpet
    //  side everything is deadened. The two halves are OPEN to each other at x=0.
    //  Reach it: walk far north (+Z) to z~30, then veer east to the doorway at x[3,7].
    // ============================================================
    // -- West (carpet/foam) shell --
    { "EntityId": 500, "PrefabId": "carpet_wall",  "Position": { "X": -10, "Y": 2, "Z": 35 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // west
    { "EntityId": 501, "PrefabId": "carpet_wall",  "Position": { "X": -5,  "Y": 2, "Z": 40 }, "Scale": { "X": 5,    "Y": 1.333, "Z": 1 } },  // north-west
    { "EntityId": 502, "PrefabId": "carpet_wall",  "Position": { "X": -5,  "Y": 2, "Z": 30 }, "Scale": { "X": 5,    "Y": 1.333, "Z": 1 } },  // south-west
    { "EntityId": 503, "PrefabId": "carpet_floor", "Position": { "X": -5,  "Y": 0.05, "Z": 35 } },
    // -- East (gym) shell --
    { "EntityId": 510, "PrefabId": "concrete_wall", "Position": { "X": 10,  "Y": 2, "Z": 35 }, "Scale": { "X": 0.25, "Y": 1.333, "Z": 20 } }, // east
    { "EntityId": 511, "PrefabId": "concrete_wall", "Position": { "X": 5,   "Y": 2, "Z": 40 }, "Scale": { "X": 5,    "Y": 1.333, "Z": 1 } },  // north-east
    { "EntityId": 512, "PrefabId": "concrete_wall", "Position": { "X": 1.5, "Y": 2, "Z": 30 }, "Scale": { "X": 1.5,  "Y": 1.333, "Z": 1 } },  // south-east-left  (x0..3)
    { "EntityId": 513, "PrefabId": "concrete_wall", "Position": { "X": 8.5, "Y": 2, "Z": 30 }, "Scale": { "X": 1.5,  "Y": 1.333, "Z": 1 } },  // south-east-right (x7..10) -> door x3..7
    { "EntityId": 514, "PrefabId": "wood_floor",    "Position": { "X": 5,   "Y": 0.05, "Z": 35 } },
    // -- Acoustic regions + portals --
    { "EntityId": 530, "PrefabId": "acoustic_region", "Position": { "X": 5,  "Y": 2, "Z": 35 }, "IsIndoor": true, "RoomMaterials": ["Wood", "Concrete", "Concrete", "Concrete", "Concrete", "Concrete"] }, // GYM (live)
    { "EntityId": 540, "PrefabId": "acoustic_region", "Position": { "X": -5, "Y": 2, "Z": 35 }, "IsIndoor": true, "RoomMaterials": ["Carpet", "Carpet", "Carpet", "Carpet", "Carpet", "Carpet"] },         // CARPET (dead)
    { "EntityId": 531, "PrefabId": "portal", "Position": { "X": 0, "Y": 2, "Z": 35 }, "RegionAId": 530, "RegionBId": 540, "ApertureSize": 8.0 }, // open between halves
    { "EntityId": 532, "PrefabId": "portal", "Position": { "X": 5, "Y": 1, "Z": 30 }, "RegionAId": -1,  "RegionBId": 530, "ApertureSize": 4.0 }, // entry doorway (gym side)
    // -- Megaphone on the DEAD side, beaming EAST (+X) into the live half --
    { "EntityId": 520, "PrefabId": "space_megaphone", "Position": { "X": -5, "Y": 1.5, "Z": 35 }, "Rotation": { "X": 0, "Y": 0.7071, "Z": 0, "W": 0.7071 } },

    // ============================================================
    //  THINGS TO PICK UP
    //  Scattered on purpose rather than heaped at the spawn point: finding one is half of what
    //  carrying things is for, and a heap teaches nothing. They are also on DIFFERENT FLOORS —
    //  concrete, grass, carpet, wood — because putting a thing down makes the noise its mass and
    //  its material make meeting THAT floor, and the four of them are easy to tell apart by ear.
    //
    //  The rifle takes both hands and the torch takes one, so picking both up is the decision the
    //  whole two-hand constraint exists to force.
    // ============================================================
    { "EntityId": 600, "PrefabId": "crowbar",      "Position": { "X": 1.2,  "Y": 0.05, "Z": 2.5 } },   // concrete, a few steps from spawn
    { "EntityId": 601, "PrefabId": "torch",        "Position": { "X": -0.6, "Y": 0.05, "Z": 6.5 } },   // on the grass strip
    { "EntityId": 602, "PrefabId": "sword",        "Position": { "X": -7,   "Y": 0.05, "Z": 16 } },    // concrete room, west
    { "EntityId": 603, "PrefabId": "akm_rifle",    "Position": { "X": 7,    "Y": 0.05, "Z": 13 } },    // wood room, east
    { "EntityId": 604, "PrefabId": "glock_pistol", "Position": { "X": -5,   "Y": 0.05, "Z": 36 } }     // the carpet half of the lab
  ]
}
