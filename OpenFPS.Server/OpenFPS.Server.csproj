<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
    <!-- Maps, prefabs, composites and the world's tiles (docs/ENGINE_PACKAGES.md, stage 4): the server makes them
         into entities and names their folders. -->
    <ProjectReference Include="..\OpenFPS.World\OpenFPS.World.csproj" />
    <!-- Traffic, trains and aircraft as they are driven, and the street's laws (docs/ENGINE_PACKAGES.md, stage 5):
         the server steps them over its entities. -->
    <ProjectReference Include="..\OpenFPS.Agents\OpenFPS.Agents.csproj" />
    <!-- The compass points: /wind, /build, the editor and the world's "north east of" say them. -->
    <ProjectReference Include="..\OpenFPS.Words\OpenFPS.Words.csproj" />
    <!-- The beacons' categories and a map's policy for them; coordinates as a player types them. -->
    <ProjectReference Include="..\OpenFPS.Accessibility\OpenFPS.Accessibility.csproj" />
    <!-- The world editor's model (docs/ENGINE_PACKAGES.md, stage 8): WorldEditor's commands step it. -->
    <ProjectReference Include="..\OpenFPS.Editor\OpenFPS.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
    <!-- The native SQLite under EF Core: 2.1.10 bundles SQLite before 3.50.2 (CVE-2025-6965, GHSA-2m69-gcr7-jv3q).
         The 3.x lib packages carry the native library only and follow SQLite's own version. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenFPS.Tests" />
    <InternalsVisibleTo Include="OpenFPS.AudioLab" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
