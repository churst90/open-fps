<Project Sdk="Microsoft.NET.Sdk">

  <!-- The catalogue of what things are (docs/ENGINE_PACKAGES.md, 3.3 and stage 2): machines as parts lists and
       their registry, the models a map can name, the one table of model kinds and each kind's fields for the
       editor, a vehicle as the world editor stores it, which glass a glazed part is, the voices and what each
       can say, what a scope and a round are. It sits above the sound and the physics and hands out their
       presets; nothing below it asks it anything: a sound model that names another preset is handed it
       (IPresets).

       Namespaces follow the project and its folders: OpenFPS.Models, OpenFPS.Models.Editing; Speech/ is
       OpenFPS.Models too, since its one type is Speech (docs/SOUND_LIBRARY_BOUNDARY.md 21). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Geometry\OpenFPS.Geometry.csproj" />
    <ProjectReference Include="..\OpenFPS.Materials\OpenFPS.Materials.csproj" />
    <ProjectReference Include="..\OpenFPS.Acoustics\OpenFPS.Acoustics.csproj" />
    <ProjectReference Include="..\OpenFPS.Physics\OpenFPS.Physics.csproj" />
    <!-- The fires it hands out (FireSpec, Environment's since stage 3). -->
    <ProjectReference Include="..\OpenFPS.Environment\OpenFPS.Environment.csproj" />
    <ProjectReference Include="..\OpenFPS.Schema\OpenFPS.Schema.csproj" />
    <ProjectReference Include="..\OpenFPS.Sound\OpenFPS.Sound.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A pane that declares no glazing is logged (decision 5 of the library survey: Serilog's static Log stays). -->
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The voices' lines, named in Speech's namespace: Speech reads them from its own assembly by these names. -->
    <EmbeddedResource Include="Speech\voices.csv" LogicalName="OpenFPS.Models.Speech.voices.csv" />
    <EmbeddedResource Include="Speech\scripts.json" LogicalName="OpenFPS.Models.Speech.scripts.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests and the lab reach the registries' hooks, as they do the sound's. -->
    <InternalsVisibleTo Include="OpenFPS.Tests" />
    <InternalsVisibleTo Include="OpenFPS.AudioLab" />
  </ItemGroup>

</Project>
