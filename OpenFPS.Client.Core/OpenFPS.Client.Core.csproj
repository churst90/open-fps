<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
    <!-- The compass points: the F key's facing and the driving aids' heading say them. -->
    <ProjectReference Include="..\OpenFPS.Words\OpenFPS.Words.csproj" />
    <!-- The keys, the speech output and the aids that read no world (docs/ENGINE_PACKAGES.md, stage 7). -->
    <ProjectReference Include="..\OpenFPS.Accessibility\OpenFPS.Accessibility.csproj" />
    <!-- FMOD's wrapper and the Steam Audio bindings (docs/SOUND_LIBRARY_BOUNDARY.md, stage 1). -->
    <ProjectReference Include="..\OpenFPS.Native\OpenFPS.Native.csproj" />
    <!-- The sound library's runtime: the mixer, Steam Audio, the acoustic worker (stage 6). This project is its host. -->
    <ProjectReference Include="..\OpenFPS.Audio\OpenFPS.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach the engine's test constructors and hooks, and the AudioLab's spikes drive its
         internals directly: that is what a spike is. The Phonon P/Invoke surface itself is internal to
         OpenFPS.Native, which grants the same two (and this project). -->
    <InternalsVisibleTo Include="OpenFPS.Tests" />
    <InternalsVisibleTo Include="OpenFPS.AudioLab" />
  </ItemGroup>

</Project>
