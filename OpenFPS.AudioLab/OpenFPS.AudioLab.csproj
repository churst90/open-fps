<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenFPS.AudioLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
    <ProjectReference Include="..\OpenFPS.Client.Core\OpenFPS.Client.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <!-- The audio engine + diagnostics now live in OpenFPS.Client.Core (referenced above);
       no source globbing needed. -->

  <!-- Drop FMOD's Linux engine libraries (libfmod.so, libfmodL.so) into the repo-root lib/
       folder. Get them free from https://www.fmod.com/download (FMOD Engine > Linux). -->
  <ItemGroup>
    <None Include="..\lib\*.so" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
