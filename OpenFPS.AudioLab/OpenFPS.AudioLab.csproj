<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OpenFPS.AudioLab</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFPS.Common\OpenFPS.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <!-- Cross-platform spike: reuse the platform-neutral audio engine source DIRECTLY (no file
       moves), so the Windows client build is completely untouched. This proves the FMOD audio
       engine runs on Linux and lets you run the spatial-audio orbit test on your own machine. -->
  <ItemGroup>
    <Compile Include="..\OpenFPS.Client\AudioEngine\**\*.cs" />
    <Compile Include="..\OpenFPS.Client\Core\FmodNative\**\*.cs" />
    <Compile Include="..\OpenFPS.Client\Core\SpatialService.cs" />
    <Compile Include="..\OpenFPS.Client\Core\AudioDiagnostics.cs" />
  </ItemGroup>

  <!-- Drop FMOD's Linux engine libraries (libfmod.so, libfmodL.so) into the repo-root lib/
       folder. Get them free from https://www.fmod.com/download (FMOD Engine > Linux). -->
  <ItemGroup>
    <None Include="..\lib\*.so" Link="%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
